# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT_SECRET: Secret key used to sign HttpOnly admin session JWT cookies
JWT_SECRET="MY_JWT_SECRET"

# OPERATION_MODE: 'full' (Vitrine + Agente IA) or 'agent_only' (Apenas Agente IA na rota raiz)
OPERATION_MODE="full"

# OWNER_SECRET_KEY: Optional secret key protecting GET /api/internal/ai-usage for private owner telemetry
OWNER_SECRET_KEY="MY_OWNER_SECRET_KEY"

# STORE_WHATSAPP_NUMBER: Fallback commercial WhatsApp number (DDI + DDD + Number, e.g. 5551999999999) for direct wa.me handoff
STORE_WHATSAPP_NUMBER="5551999999999"

# Web Push VAPID keys (generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@armazemdocarro.com.br"

